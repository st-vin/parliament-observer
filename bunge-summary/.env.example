# Bunge Summary — environment variables
# Copy to .env in this directory (bunge-summary/) for local development.
# Spring Boot dev profile loads optional:file:.env[.properties] automatically.
# Never commit .env with real secrets.

# --- Database (docker compose postgres on host port 5433) ---
# Port 5433 avoids clashing with a system PostgreSQL service on 5432 (common on Windows).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/bunge_summary
DB_USERNAME=bunge
DB_PASSWORD=bunge

# --- Auth (T-008 JWT) — generate: openssl rand -base64 32 ---
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000

# --- Google AI Studio (Gemini) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your-gemini-api-key

# --- OpenRouter fallback (optional) — https://openrouter.ai/keys ---
OPENROUTER_API_KEY=

# --- Email (Resend) — https://resend.com/api-keys ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@bungesummary.ke

# --- Hansard PDF storage ---
PDF_STORAGE_PATH=./data/hansard

# --- Server (Render sets PORT automatically) ---
PORT=8080

# --- Production (set in Render dashboard) ---
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=
