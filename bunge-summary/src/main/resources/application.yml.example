spring:
  application:
    name: bunge-summary
  profiles:
    active: dev
    group:
      dev:
        - api
      prod:
        - api
      auth-it:
        - api
  jpa:
    open-in-view: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
    locations: classpath:db/migration
  batch:
    jdbc:
      initialize-schema: always
    job:
      enabled: false

server:
  port: ${PORT:8080}
  error:
    include-message: always

logging:
  level:
    root: INFO
    ke.co.bungesummary: DEBUG

# Shared defaults (overridden per profile)
gemini:
  api-key: ${GEMINI_API_KEY:}
  model: gemini-1.5-flash
  embedding-model: text-embedding-004
  rate-limit-rpm: 12

openrouter:
  api-key: ${OPENROUTER_API_KEY:}
  base-url: https://openrouter.ai/api/v1

hansard:
  parliament-url: https://www.parliament.go.ke/the-national-assembly/house-business/hansard
  pdf-storage-path: ${PDF_STORAGE_PATH:./data/hansard}
  ingestion:
    cron: "0 0 6 * * *"
    max-retries: 3

notification:
  email:
    from: ${EMAIL_FROM:noreply@bungesummary.ke}
    resend-api-key: ${RESEND_API_KEY:}

jwt:
  secret: ${JWT_SECRET:}
  expiration-ms: ${JWT_EXPIRATION_MS:86400000}

---
spring:
  config:
    activate:
      on-profile: dev
    import: optional:file:.env[.properties]
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate

jwt:
  secret: ${JWT_SECRET}
